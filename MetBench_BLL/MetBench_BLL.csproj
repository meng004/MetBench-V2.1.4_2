<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!--
      Maturity remediation Phase 3 step 3: BLL is the largest legacy debt
      (~224 unique CS86xx/CS0618/etc warnings across method-level MT code).
      Per plan §3: 'BLL 最大债（458），放最后；可先上棘轮 + WarningsNotAsErrors
      白名单逐步缩小'.
      This ratchet locks the gain: any NEW warning code NOT in the whitelist
      below fails the build. The whitelist enumerates existing-debt codes;
      remove a code as the corresponding cleanup PR lands. CS0168 (silent
      catch) and CS1998 (fake async) are intentionally absent — P2 fixed them
      and any regression must fail immediately.
      See docs/superpowers/plans/2026-06-06-metbench-maturity-remediation-plan.md §3.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8601;CS8603;CS8618;CS8600;CS8602;CS8604;CS8625;CS0618;CS0219;CS0414</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.7.1" />
    <PackageReference Include="LiveChartsCore" Version="2.0.0-rc5.4" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.0-rc5.4" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <!-- Cloud CI ubuntu-24.04 needs the Linux native runtime. NoDependencies bundles
         everything skia needs so we don't have to apt-get fontconfig at build time. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetBench_BLL.Core\MetBench_BLL.Core.csproj" />
    <ProjectReference Include="..\MetBench_DAL\MetBench_DAL.csproj" />
    <ProjectReference Include="..\MetBench_IDAL\MetBench_IDAL.csproj" />
  </ItemGroup>

</Project>
