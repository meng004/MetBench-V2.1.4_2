<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!--
      Maturity remediation Phase 3: IDAL is now 0-warning under nullable;
      this ratchet locks the gain so future contract fields can't reintroduce
      silent NPE risk. See
      docs/superpowers/plans/2026-06-06-metbench-maturity-remediation-plan.md §3.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetBench_Domain\MetBench_Domain.csproj" />
  </ItemGroup>

</Project>
