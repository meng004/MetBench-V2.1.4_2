#!/usr/bin/env python3
from __future__ import annotations

import importlib.util
import sys
from pathlib import Path


def _load_server_module():
    repo_root = Path(__file__).resolve().parents[1]
    server_path = repo_root / "infra" / "mcp" / "docker-runtime" / "server.py"
    spec = importlib.util.spec_from_file_location("metbench_docker_runtime_mcp_server", server_path)
    module = importlib.util.module_from_spec(spec)
    if spec.loader is None:
        raise RuntimeError(f"Cannot load Docker runtime MCP server from {server_path}")
    spec.loader.exec_module(module)
    return module


def main() -> int:
    return _load_server_module().main(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
