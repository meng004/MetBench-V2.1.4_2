<UserControl x:Class="MetBench_Client.Controls.SimplePagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button x:Name="PrevBtn" Content="&#9664;" Width="32" Height="30"
                   FontSize="12" Margin="0 0 4 0"
                   Click="PrevBtn_Click"/>
        <TextBlock x:Name="PageLabel" Text="1 / 1"
                   VerticalAlignment="Center" Margin="4 0"
                   FontSize="13"/>
        <ui:Button x:Name="NextBtn" Content="&#9654;" Width="32" Height="30"
                   FontSize="12" Margin="4 0 0 0"
                   Click="NextBtn_Click"/>
    </StackPanel>
</UserControl>
