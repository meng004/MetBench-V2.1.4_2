<Page
    x:Class="MetBench_Client.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance local:SettingsPage,
                                  IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <StackPanel Margin="42" >
        <TextBlock
        FontSize="20"
        FontWeight="Medium"
        Text="{Binding ViewModel.Localization[Settings_Personalization]}" />
        <TextBlock Margin="0,12,0,0" Text="{Binding ViewModel.Localization[Settings_Theme]}" />
        <RadioButton
        Margin="0,12,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_light"
        Content="{Binding ViewModel.Localization[Settings_Theme_Light]}"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentApplicationTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
        <RadioButton
        Margin="0,8,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_dark"
        Content="{Binding ViewModel.Localization[Settings_Theme_Dark]}"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentApplicationTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />

        <TextBlock Margin="0,24,0,0" Text="{Binding ViewModel.Localization[Settings_Language]}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ComboBox
                ItemsSource="{Binding ViewModel.AvailableCultures}"
                SelectedItem="{Binding ViewModel.SelectedCulture, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                MinWidth="160" />
            <Button
                Margin="8,0,0,0"
                Command="{Binding ViewModel.ChangeCultureCommand}"
                CommandParameter="{Binding ViewModel.SelectedCulture.Culture.Name}"
                Content="{Binding ViewModel.Localization[Settings_Apply]}" />
        </StackPanel>

        <TextBlock
        Margin="0,24,0,0"
        FontSize="20"
        FontWeight="Medium"
        Text="{Binding ViewModel.Localization[Settings_About]}" />
        <TextBlock  Margin="0,12,0,0" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
        <TextBlock
            Margin="0,24,0,8"
            FontWeight="SemiBold"
            Text="{Binding ViewModel.Localization[Settings_More]}" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ViewModel.Localization[Settings_ProjectIntroduction]}" Margin="0 5 10 0"/>
            <TextBlock Margin="0 5 0 0">
                <Hyperlink NavigateUri="https://github.com/Zhaoyin0910/MetBench" RequestNavigate="Hyperlink_OnRequestNavigate">
                    <Run Text="{Binding ViewModel.Localization[Settings_SourceCode], Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
            <TextBlock VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Settings_CloneRepository]}" Margin="0 5 10 0"/>
            <TextBlock VerticalAlignment="Center" Margin="5 5 0 0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="https://github.com/Zhaoyin0910/MetBench.git" />
        </StackPanel>
    </StackPanel>
</Page>
