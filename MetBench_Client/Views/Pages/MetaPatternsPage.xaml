<Page x:Class="MetBench_Client.Views.Pages.MetaPatternsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:MetBench_Client.Views.Controls"
      xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="MetaPatternsPage"
      d:DesignHeight="700" d:DesignWidth="1200"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}" />
    </Page.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: toolbar -->
            <RowDefinition Height="*" />     <!-- 1: grid + edit form -->
            <RowDefinition Height="Auto" />  <!-- 2: paging bar -->
            <RowDefinition Height="Auto" />  <!-- 3: status + error footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ViewModel.Localization[MetaPattern_Title]}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ui:Button Appearance="Primary"
                       Content="{Binding ViewModel.Localization[Legacy_Add]}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.BeginAddCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Appearance="Secondary"
                       Content="{Binding ViewModel.Localization[Legacy_Modify]}"
                       Icon="{ui:SymbolIcon Edit24}"
                       Command="{Binding ViewModel.BeginEditCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Appearance="Secondary"
                       Content="{Binding ViewModel.Localization[MetaPattern_ToggleStatus]}"
                       Icon="{ui:SymbolIcon ArrowSwap24}"
                       Command="{Binding ViewModel.ToggleStatusCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Appearance="Caution"
                       Content="{Binding ViewModel.Localization[MetaPattern_SoftDelete]}"
                       Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding ViewModel.SoftDeleteCommand}" />
        </StackPanel>

        <!-- Row 1: split panel — DataGrid (left, 2*) + Edit form (right, 1*) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: DataGrid -->
            <ui:DataGrid Grid.Column="0"
                         ItemsSource="{Binding ViewModel.Items}"
                         SelectedItem="{Binding ViewModel.SelectedPattern, Mode=TwoWay}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         HeadersVisibility="Column"
                         CanUserAddRows="False"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnCode], Source={StaticResource LocalizationProxy}}"            Binding="{Binding Code}"                     Width="100" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Legacy_Name], Source={StaticResource LocalizationProxy}}"            Binding="{Binding Name}"                     Width="160" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnBlock], Source={StaticResource LocalizationProxy}}"           Binding="{Binding Block}"                    Width="160" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnDefaultAssertion], Source={StaticResource LocalizationProxy}}" Binding="{Binding DefaultAssertionTypeCode}" Width="140" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnTolRel], Source={StaticResource LocalizationProxy}}"         Binding="{Binding DefaultToleranceRel, StringFormat=G6}" Width="80" />
                    <DataGridCheckBoxColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnNoise], Source={StaticResource LocalizationProxy}}"       Binding="{Binding NoiseAware}"               Width="60" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnStatus], Source={StaticResource LocalizationProxy}}"          Binding="{Binding Status}"                   Width="100" />
                    <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[MetaPattern_ColumnOutOfScopeReason], Source={StaticResource LocalizationProxy}}" Binding="{Binding OutOfScopeReason}"     Width="*" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Middle: splitter visual -->
            <Border Grid.Column="1" Width="8" />

            <!-- Right: edit form (visible only when EditingPattern != null) -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4"
                    Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.EditingPattern}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,8">
                        <TextBlock.Text>
                            <PriorityBinding>
                                <Binding Path="ViewModel.EditingPattern.Code" StringFormat="Editing: {0}" />
                                <Binding Source="(new)" />
                            </PriorityBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldCode]}" Margin="0,4,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding ViewModel.IsAdding}" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldName]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldBlock]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.Block, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldDefaultAssertionType]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.DefaultAssertionTypeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldDefaultTolerance]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.DefaultToleranceRel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="{Binding ViewModel.Localization[MetaPattern_FieldNoiseAware]}"
                              IsChecked="{Binding ViewModel.EditingPattern.NoiseAware, Mode=TwoWay}"
                              Margin="0,8,0,0" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldStatus]}" Margin="0,8,0,2" />
                    <ComboBox SelectedValue="{Binding ViewModel.EditingPattern.Status, Mode=TwoWay}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="active" />
                        <ComboBoxItem Content="deprecated" />
                        <ComboBoxItem Content="experimental" />
                        <ComboBoxItem Content="out-of-scope" />
                    </ComboBox>

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldOutOfScopeReason]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.OutOfScopeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                MinHeight="48" />

                    <TextBlock Text="{Binding ViewModel.Localization[MetaPattern_FieldHypothesisTemplate]}" Margin="0,8,0,2" />
                    <ui:TextBox Text="{Binding ViewModel.EditingPattern.HypothesisTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                MinHeight="48" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Appearance="Primary"
                                   Content="{Binding ViewModel.Localization[Legacy_Save]}"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding ViewModel.SaveCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Appearance="Secondary"
                                   Content="{Binding ViewModel.Localization[Legacy_Cancel]}"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding ViewModel.CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: paging bar -->
        <controls:PagingBar Grid.Row="2" Margin="0,8,0,0"
                            DataContext="{Binding ViewModel}" />

        <!-- Row 3: status + error footer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding ViewModel.StatusMessage}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Column="1"
                       Foreground="OrangeRed"
                       Text="{Binding ViewModel.ErrorMessage}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
