<Page x:Class="MetBench_Client.Views.Pages.AutoDetectMRPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
      xmlns:models="clr-namespace:MetBench_Domain;assembly=MetBench_Domain"
      xmlns:util="clr-namespace:MetBench_Client.Util"
      xmlns:s="https://github.com/canton7/Stylet"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:MetBench_Client.ViewModels"
      xmlns:controls="clr-namespace:MetBench_Client.Controls"
      xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1000"
     d:DataContext="{d:DesignInstance viewmodels:AutoDetectMRViewModel}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="AutoDetectMRPage">
    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <ui:DataGrid Grid.Row="0"  VerticalAlignment="Top" BorderThickness="2" BorderBrush="LightGray" Margin="10 0 10 10" HorizontalAlignment="Center"  AutoGenerateColumns="False"    ItemsSource="{Binding ViewModel.Data,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  CanUserAddRows="False"  x:Name="datagrid"   AutomationProperties.AutomationId="DataGrid_MRSelectedItem"
         s:View.ActionTarget="{Binding ViewModel}" LoadingRowDetails="datagrid_LoadingRowDetails" 
          >
                <!--进行datagrid的TextColumn 进行居中-->
                <DataGrid.Resources>
                    <util:IndexConverter x:Key="IndexConverter"/>
                    <Style x:Key="CenteredTextBlockStyle" TargetType="{x:Type TextBlock}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!--<DataGridTemplateColumn  Width="70"  MinWidth="10" IsReadOnly="True" >
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="Number" HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}"  HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn >-->
  
                    <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding ApplicationName}" Width="200" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Detect_ApplicationName], Source={StaticResource LocalizationProxy}}" AutomationProperties.AutomationId="DataGridTextColumn_ApplicationName"></TextBlock>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Detect_InputPattern], Source={StaticResource LocalizationProxy}}"></TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalContentAlignment="Center">
                                    <Image Source="{Binding InputPatternimagepath}"/>
                                </ScrollViewer>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn >
                        <DataGridTemplateColumn.Header>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Data.ViewModel.Localization[Detect_OutputPattern], Source={StaticResource LocalizationProxy}}"></TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalContentAlignment="Center">
                                    <Image Source="{Binding OutputPatternimagepath}" />
                                </ScrollViewer>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding DimensionOfInputPattern}" Width="200" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Detect_DimensionOfInputPattern], Source={StaticResource LocalizationProxy}}"></TextBlock>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding TrueRatio}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Detect_TrueRatio], Source={StaticResource LocalizationProxy}}"></TextBlock>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
            <Grid Grid.Row="1">
                <controls:SimplePagination x:Name="pagination" Margin="0 2 5 0" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    MaxPageCount="{Binding ViewModel.MaxPageCount, UpdateSourceTrigger=PropertyChanged}"
                    PageIndex="{Binding ViewModel.PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PageUpdated="pagination_PageUpdated"/>
            </Grid>
        </Grid>
        <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" >-->
        
        <!--</StackPanel>-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <StackPanel  Grid.Row="0" x:Name="stackpanel1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.Localization[Detect_Program]}"  Margin="65 0 0 0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="txbCodeName" Margin="25 0 0 0" VerticalContentAlignment="Center" Width="150"
                                IsReadOnly="True"
                                InputMethod.IsInputMethodEnabled="False"
                                Language="en-US"
                                ClearButtonEnabled="False"  
                                TextWrapping="Wrap"
                                Text="{Binding ViewModel.CodeName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                />
                    <ui:Button Appearance="Info" Content="{Binding ViewModel.Localization[Detect_WithdrawUpload]}"
                               Margin="5 0 0 0"
                               s:View.ActionTarget="{Binding ViewModel}"
                               Command="{s:Action btnBack_Click}" 
                               />
                    <ui:Button Appearance="Primary" Content="{Binding ViewModel.Localization[Detect_Upload]}" Margin="5 0 0 0"
                               s:View.ActionTarget="{Binding ViewModel}"
                               Command="{s:Action btnAddCode_Click}"
                               Icon="{ui:SymbolIcon ArrowUpload24}"
                               />
                </StackPanel>
                <StackPanel  Grid.Row="1" x:Name="stackpanel2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.Localization[Detect_InputParamCount]}"  Margin="20 0 0 0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="txbInputParamCount"  Margin="8 0 0 0" VerticalContentAlignment="Center" Width="170"
                             InputMethod.IsInputMethodEnabled="False"
                             Language="en-US"
                             TextWrapping="Wrap"
                             Text="{Binding ViewModel.InputParamCount,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                             />
                    <ui:Button Appearance="Primary"  Content="{Binding ViewModel.Localization[Detect_Reset]}" Margin="3 0 0 0"
                                Icon="{ui:SymbolIcon TextBulletListSquareSettings20}"
                                s:View.ActionTarget="{Binding ViewModel}"
                                Command="{s:Action btn_Cancle}"
                               />
                </StackPanel>
                <StackPanel  Grid.Row="2" x:Name="stackpanel3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.Localization[Detect_InputParamRanges]}"  Margin="15 0 0 0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="txbMaxNumber"  Margin="5 0 0 0" VerticalContentAlignment="Center" Width="170"
                             InputMethod.IsInputMethodEnabled="False"
                             Language="en-US"
                             TextWrapping="Wrap"
                             Text="{Binding ViewModel.InputParamRanges,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             />
                </StackPanel>
                <StackPanel  Grid.Row="3" x:Name="stackpanel4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.Localization[Detect_InputDatatypes]}"  Margin="40 0 0 0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="txbExecuteNumb" Margin="5 0 0 0" VerticalContentAlignment="Center" Width="170"
                             InputMethod.IsInputMethodEnabled="False"
                             Language="en-US"
                             TextWrapping="Wrap"
                             Text="{Binding ViewModel.InputDatatypes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             />
                </StackPanel>
                <!--<StackPanel  Grid.Row="4" x:Name="stackpanel5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Repet"  Margin="105 0 0 0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="txbRepet" Margin="5 0 0 0" VerticalContentAlignment="Center" Width="170"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.Repet,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              />
                </StackPanel>-->

            </Grid>
            <Grid Grid.Column="1" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74.762"/>
                    <RowDefinition Height="74.762"/>
                    <RowDefinition Height="74.762"/>
                    <RowDefinition/>

                    
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ui:Button Appearance="Primary"  Content="{Binding ViewModel.Localization[Detect_DetectMR]}"
                               Margin="0 0 0 20"
                                Icon="{ui:SymbolIcon CalendarEdit24}"
                                s:View.ActionTarget="{Binding ViewModel}"
                                Command="{s:Action btn_AutoDetectMR}"
                               />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ui:Button Appearance="Primary"  Content="{Binding ViewModel.Localization[Detect_StoreMR]}"
                 Icon="{ui:SymbolIcon DocumentArrowDown20}"
                 s:View.ActionTarget="{Binding ViewModel}"
                 Command="{s:Action btn_StoreMR}"
                />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ui:Button Appearance="Primary"  Content="{Binding ViewModel.Localization[Detect_ExportCsv]}"
                               Margin="0 20 0 0"
                               Icon="{ui:SymbolIcon DocumentArrowDown20}"
                               s:View.ActionTarget="{Binding ViewModel}"
                               Command="{s:Action btn_ExportCsv}"
                               />
                </StackPanel>
            </Grid>

        </Grid>
        <Grid Grid.Row="2">
            <ProgressBar IsIndeterminate="{Binding ViewModel.IsIndeterminate,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Visibility="{Binding ViewModel.Visibility, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"    Height="20"  BorderThickness="2" />

        </Grid>

    </Grid>
</Page>
