<Page x:Class="MetBench_Client.Views.Pages.DiscoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
      Title="DiscoveryPage"
      d:DesignHeight="700" d:DesignWidth="1100"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}" />
    </Page.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: controls bar -->
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ViewModel.Localization[Discovery_DiscovererLabel]}" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ViewModel.DiscovererList}"
                          SelectedItem="{Binding ViewModel.SelectedDiscoverer, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="200" Margin="0,0,16,0" />

                <TextBlock Text="{Binding ViewModel.Localization[Discovery_TargetSutLabel]}" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ViewModel.Applications}"
                          SelectedItem="{Binding ViewModel.SelectedApplication, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="200" Margin="0,0,16,0" />

                <Button
                           Content="{Binding ViewModel.Localization[Discovery_RunButton]}"
                           Command="{Binding ViewModel.RunDiscoveryCommand}" />

                <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                             Margin="12,0,0,0" VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Border>

        <!-- Row 1: status / error row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding ViewModel.StatusMessage}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <TextBlock Text="{Binding ViewModel.ErrorMessage}"
                       Foreground="OrangeRed"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 2: candidate MR results DataGrid -->
        <DataGrid Grid.Row="2"
                     ItemsSource="{Binding ViewModel.CandidateItems}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     HeadersVisibility="Column"
                     CanUserAddRows="False"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColCode], Source={StaticResource LocalizationProxy}}"       Binding="{Binding ProposedCode}"                 Width="160" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Legacy_Name], Source={StaticResource LocalizationProxy}}"       Binding="{Binding ProposedName}"                 Width="*" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColAssertion], Source={StaticResource LocalizationProxy}}"  Binding="{Binding SuggestedAssertionTypeCode}"   Width="100" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColValue], Source={StaticResource LocalizationProxy}}"      Binding="{Binding ProposedValueName}"            Width="80" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColConfidence], Source={StaticResource LocalizationProxy}}" Binding="{Binding Confidence, StringFormat=F2}"  Width="90" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColStatus], Source={StaticResource LocalizationProxy}}"     Binding="{Binding Status}"                       Width="80" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Discovery_ColCreated], Source={StaticResource LocalizationProxy}}"    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
