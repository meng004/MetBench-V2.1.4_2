<Page
    x:Class="MetBench_Client.Views.Pages.SystemMtMrCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SystemMtMrCatalogPage"
    d:DataContext="{d:DesignInstance local:SystemMtMrCatalogPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    AutomationProperties.AutomationId="SystemMtMrCatalogPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="22" FontWeight="Medium" Text="{Binding ViewModel.Localization[Catalog_MrCatalogTitle]}"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.Localization[Catalog_MrCatalogSubtitle]}"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.Localization[Catalog_Manifest]}"/>
                    <ComboBox
                        x:Name="ComboBox_SystemMtManifest"
                        Margin="0,4,0,0"
                        AutomationProperties.AutomationId="ComboBox_SystemMtManifest"
                        DisplayMemberPath="SutId"
                        ItemsSource="{Binding ViewModel.Manifests, Mode=OneWay}"
                        SelectedItem="{Binding ViewModel.SelectedManifest, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,22,0,0" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.RefreshManifestsCommand, Mode=OneWay}"
                        Content="{Binding ViewModel.Localization[Catalog_Reload]}"/>
                    <Button
                        x:Name="Button_NewMrDraft"
                        AutomationProperties.AutomationId="Button_NewMrDraft"
                        Command="{Binding ViewModel.NewMrDraftCommand, Mode=OneWay}"
                        Content="{Binding ViewModel.Localization[Catalog_NewMrDraft]}"/>
                </StackPanel>

                <TextBlock
                    x:Name="TextBlock_SystemMtMrCatalogStatus"
                    Grid.Column="2"
                    Margin="16,22,0,0"
                    AutomationProperties.AutomationId="TextBlock_SystemMtMrCatalogStatus"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <DataGrid
                    x:Name="DataGrid_SystemMtMrBindings"
                    AutomationProperties.AutomationId="DataGrid_SystemMtMrBindings"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.MrBindings, Mode=OneWay}"
                    SelectedItem="{Binding ViewModel.SelectedDraft, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="160" Binding="{Binding MrId}" Header="{Binding Data.ViewModel.Localization[Catalog_MrId], Source={StaticResource LocalizationProxy}}"/>
                        <DataGridTextColumn Width="140" Binding="{Binding AssertionTypeCode}" Header="{Binding Data.ViewModel.Localization[Catalog_Assertion], Source={StaticResource LocalizationProxy}}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding ValueName}" Header="{Binding Data.ViewModel.Localization[Catalog_Value], Source={StaticResource LocalizationProxy}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border
                    x:Name="Border_MrExplanationCard"
                    Margin="0,0,0,12"
                    Padding="14"
                    AutomationProperties.AutomationId="Border_MrExplanationCard"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" FontWeight="Medium" Text="{Binding ViewModel.Localization[SystemMt_Mr_ExplanationHeader]}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_MetaPatternRationale]}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.MetaPatternRationaleDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_TransformationSemantics]}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.TransformationSemanticsDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_Observables]}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.ObservablesDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_Predicate]}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.PredicateDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_Tolerance]}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.ToleranceDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_Applicability]}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.ApplicabilityDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Mr_FailureMeaning]}"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ViewModel.FailureMeaningDisplay, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border
                    Padding="14"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_MrId]}"/>
                        <TextBox
                            x:Name="TextBox_MrId"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            AutomationProperties.AutomationId="TextBox_MrId"
                            Text="{Binding ViewModel.SelectedDraft.MrId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_DisplayName]}"/>
                        <TextBox
                            x:Name="TextBox_DisplayName"
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_DisplayName"
                            Text="{Binding ViewModel.SelectedDraft.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Legacy_Description]}"/>
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Margin="0,0,0,8"
                            Text="{Binding ViewModel.SelectedDraft.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_Transformation]}"/>
                        <TextBox
                            x:Name="TextBox_TransformationName"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            AutomationProperties.AutomationId="TextBox_TransformationName"
                            Text="{Binding ViewModel.SelectedDraft.TransformationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_Assertion]}"/>
                        <ComboBox
                            x:Name="ComboBox_AssertionTypeCode"
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="ComboBox_AssertionTypeCode"
                            ItemsSource="{Binding ViewModel.AvailableAssertionTypeCodes, Mode=OneWay}"
                            SelectedItem="{Binding ViewModel.SelectedDraft.AssertionTypeCode, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_AssertionName]}"/>
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            Text="{Binding ViewModel.SelectedDraft.AssertionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_ValueName]}"/>
                        <TextBox
                            x:Name="TextBox_ValueName"
                            Grid.Row="3"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_ValueName"
                            Text="{Binding ViewModel.SelectedDraft.ValueName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_EquationKey]}"/>
                        <TextBox
                            x:Name="TextBox_EquationKey"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            AutomationProperties.AutomationId="TextBox_EquationKey"
                            Text="{Binding ViewModel.SelectedDraft.EquationKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_MetaPattern]}"/>
                        <TextBox
                            x:Name="TextBox_MetaPattern"
                            Grid.Row="4"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_MetaPattern"
                            Text="{Binding ViewModel.SelectedDraft.MetaPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_SampleCase]}"/>
                        <TextBox
                            x:Name="TextBox_SampleCaseRelativePath"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            AutomationProperties.AutomationId="TextBox_SampleCaseRelativePath"
                            Text="{Binding ViewModel.SelectedDraft.SampleCaseRelativePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_WorkRoot]}"/>
                        <TextBox
                            x:Name="TextBox_WorkRootName"
                            Grid.Row="5"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_WorkRootName"
                            Text="{Binding ViewModel.SelectedDraft.WorkRootName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_TimeoutSeconds]}"/>
                        <TextBox
                            x:Name="NumberBox_TimeoutSeconds"
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            AutomationProperties.AutomationId="NumberBox_TimeoutSeconds"
                            Text="{Binding ViewModel.SelectedDraft.TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_Factor]}"/>
                        <TextBox
                            x:Name="TextBox_Factor"
                            Grid.Row="6"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_Factor"
                            Text="{Binding ViewModel.SelectedDraft.Factor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_TransformStep]}"/>
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="0,0,12,8"
                            Text="{Binding ViewModel.SelectedDraft.TransformStepName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_TargetFieldPath]}"/>
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="3"
                            Margin="0,0,0,8"
                            Text="{Binding ViewModel.SelectedDraft.TransformTargetFieldPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                x:Name="Button_ValidateMrDraft"
                                Margin="0,12,8,0"
                                AutomationProperties.AutomationId="Button_ValidateMrDraft"
                                Command="{Binding ViewModel.ValidateMrDraftCommand, Mode=OneWay}"
                                Content="{Binding ViewModel.Localization[Catalog_Validate]}"/>
                            <Button
                                x:Name="Button_SaveMrDraft"
                                Margin="0,12,0,0"
                                AutomationProperties.AutomationId="Button_SaveMrDraft"
                                Command="{Binding ViewModel.SaveMrDraftCommand, Mode=OneWay}"
                                Content="{Binding ViewModel.Localization[Legacy_Save]}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
