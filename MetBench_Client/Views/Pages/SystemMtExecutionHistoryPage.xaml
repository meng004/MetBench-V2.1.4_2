<Page
    x:Class="MetBench_Client.Views.Pages.SystemMtExecutionHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SystemMtExecutionHistoryPage"
    d:DataContext="{d:DesignInstance local:SystemMtExecutionHistoryPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    AutomationProperties.AutomationId="SystemMtExecutionHistoryPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="22" FontWeight="Medium" Text="{Binding ViewModel.Localization[History_ExecutionHistory]}"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.Localization[History_PageSubtitle]}"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.Localization[History_FilterByMrName]}"/>
                    <ui:TextBox
                        x:Name="TextBox_MrNameFilter"
                        Margin="0,4,0,0"
                        AutomationProperties.AutomationId="TextBox_MrNameFilter"
                        Text="{Binding ViewModel.MrNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,22,0,0" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}"
                        Content="{Binding ViewModel.Localization[History_Refresh]}"/>
                    <ui:Button
                        x:Name="Button_DeleteSelectedExecutions"
                        Margin="0,0,8,0"
                        Appearance="Danger"
                        AutomationProperties.AutomationId="Button_DeleteSelectedExecutions"
                        Command="{Binding ViewModel.DeleteSelectedCommand, Mode=OneWay}"
                        Content="{Binding ViewModel.Localization[History_DeleteSelected]}"/>
                </StackPanel>

                <TextBlock
                    x:Name="TextBlock_SystemMtExecutionHistoryStatus"
                    Grid.Column="2"
                    Margin="16,22,0,0"
                    AutomationProperties.AutomationId="TextBlock_SystemMtExecutionHistoryStatus"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ui:DataGrid
                x:Name="DataGrid_SystemMtExecutionHistory"
                AutomationProperties.AutomationId="DataGrid_SystemMtExecutionHistory"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding ViewModel.Records, Mode=OneWay}"
                SelectedItem="{Binding ViewModel.SelectedRecord, Mode=TwoWay}"
                SelectionMode="Extended">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Width="160" Binding="{Binding RunAt, StringFormat=u}" Header="{Binding Data.ViewModel.Localization[History_Column_RunAt], Source={StaticResource LocalizationProxy}}"/>
                    <DataGridTextColumn Width="220" Binding="{Binding MrName}" Header="{Binding Data.ViewModel.Localization[History_Column_Mr], Source={StaticResource LocalizationProxy}}"/>
                    <DataGridTextColumn Width="140" Binding="{Binding AssertionName}" Header="{Binding Data.ViewModel.Localization[History_Column_Assertion], Source={StaticResource LocalizationProxy}}"/>
                    <DataGridTextColumn Width="100" Binding="{Binding ValueName}" Header="{Binding Data.ViewModel.Localization[History_Column_Value], Source={StaticResource LocalizationProxy}}"/>
                    <DataGridTextColumn Width="90" Binding="{Binding Passed}" Header="{Binding Data.ViewModel.Localization[History_Column_Passed], Source={StaticResource LocalizationProxy}}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding FailureReason}" Header="{Binding Data.ViewModel.Localization[History_Column_FailureReason], Source={StaticResource LocalizationProxy}}"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock
                    Margin="0,6,16,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.PaginationSummary, Mode=OneWay}"/>
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ViewModel.PreviousPageCommand, Mode=OneWay}"
                    Content="{Binding ViewModel.Localization[History_PreviousPage]}"/>
                <ui:Button
                    Command="{Binding ViewModel.NextPageCommand, Mode=OneWay}"
                    Content="{Binding ViewModel.Localization[History_NextPage]}"/>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <DockPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Text="{Binding ViewModel.Localization[History_EvidenceForSelectedRow]}"/>
                <TextBox
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="TextBox_EvidenceDetails"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.SelectedEvidenceSummary, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
