<Page x:Class="MetBench_Client.Views.Pages.CoverageDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="CoverageDashboardPage"
      d:DesignHeight="750" d:DesignWidth="1100"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding ViewModel.Localization[Coverage_Title]}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2x2 chart grid -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MetaPattern chart -->
            <Border Grid.Row="0" Grid.Column="0" Margin="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ViewModel.Localization[Coverage_MetaPatternCoverage]}"
                               FontWeight="Bold" Margin="0,0,0,6" />
                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding ViewModel.MetaPatternSeries}"
                                  LegendPosition="Right"
                                  MinHeight="140" />
                    <TextBlock Grid.Row="2" Text="{Binding ViewModel.MetaPatternLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- SUT×MR chart -->
            <Border Grid.Row="0" Grid.Column="1" Margin="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ViewModel.Localization[Coverage_SutMrCoverage]}"
                               FontWeight="Bold" Margin="0,0,0,6" />
                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding ViewModel.SutMrSeries}"
                                  LegendPosition="Right"
                                  MinHeight="140" />
                    <TextBlock Grid.Row="2" Text="{Binding ViewModel.SutMrLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Bug coverage chart -->
            <Border Grid.Row="1" Grid.Column="0" Margin="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ViewModel.Localization[Coverage_BugCoverage]}"
                               FontWeight="Bold" Margin="0,0,0,6" />
                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding ViewModel.BugSeries}"
                                  LegendPosition="Right"
                                  MinHeight="140" />
                    <TextBlock Grid.Row="2" Text="{Binding ViewModel.BugLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Mutation coverage chart -->
            <Border Grid.Row="1" Grid.Column="1" Margin="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ViewModel.Localization[Coverage_MutationCoverage]}"
                               FontWeight="Bold" Margin="0,0,0,6" />
                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding ViewModel.MutationSeries}"
                                  LegendPosition="Right"
                                  MinHeight="140" />
                    <TextBlock Grid.Row="2" Text="{Binding ViewModel.MutationLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Error message -->
        <TextBlock Grid.Row="2" Text="{Binding ViewModel.ErrorMessage}"
                   Foreground="OrangeRed" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
