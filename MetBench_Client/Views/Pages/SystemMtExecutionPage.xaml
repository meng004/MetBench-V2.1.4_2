<Page
    x:Class="MetBench_Client.Views.Pages.SystemMtExecutionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SystemMtExecutionPage"
    d:DataContext="{d:DesignInstance local:SystemMtExecutionPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="22" FontWeight="Medium" Text="System-Level Metamorphic Testing"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Pick a scenario, optionally override the transformation parameter, run, and review persisted results."/>
        </StackPanel>

        <!--  Scenario picker + run controls  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="Scenario"/>
                    <ComboBox
                        Margin="0,4,0,0"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ViewModel.AvailableMrs, Mode=OneWay}"
                        SelectedItem="{Binding ViewModel.SelectedMr, Mode=TwoWay}"/>

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Factor parameter"/>
                    <ui:TextBox
                        Margin="0,4,0,0"
                        PlaceholderText="e.g. 2"
                        Text="{Binding ViewModel.FactorOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ViewModel.RunCommand, Mode=OneWay}"
                            Content="{Binding ViewModel.Localization[SystemMt_Run]}"
                            />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ViewModel.RefreshRecentCommand, Mode=OneWay}"
                            Content="Refresh recent"
                            />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Description"/>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.SelectedMr.Description, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Last result"/>
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding ViewModel.LastResultSummary, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Status"/>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Recent runs grid  -->
        <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ui:DataGrid
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding ViewModel.RecentRuns, Mode=OneWay}">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding RunAt, StringFormat=u}"
                        Header="Run At"/>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding MrName}"
                        Header="Scenario"/>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding AssertionName}"
                        Header="Assertion"/>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding ValueName}"
                        Header="Value"/>
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding SourceValue}"
                        Header="{Binding ViewModel.Localization[SystemMt_Source], RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding FollowUpValue}"
                        Header="{Binding ViewModel.Localization[SystemMt_FollowUp], RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <DataGridCheckBoxColumn
                        Width="80"
                        Binding="{Binding Passed}"
                        Header="Passed"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>

        <!--  Footer  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Command="{Binding ViewModel.ExportReportCommand, Mode=OneWay}"
                Content="Export HTML report"
                />
        </StackPanel>
    </Grid>
</Page>
