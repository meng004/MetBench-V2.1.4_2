<Page x:Class="MetBench_Client.Views.Pages.SystemMtResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:vm="clr-namespace:MetBench_Client.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="SystemMT 结果"
      d:DataContext="{d:DesignInstance Type=vm:SystemMtResultViewModel}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Row 0: toolbar (Refresh + ViewMode toggle) -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <ui:Button Content="刷新"
                 Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                 Command="{Binding ViewModel.RefreshCommand}"
                 Margin="0,0,16,0"/>
      <TextBlock Text="视图模式：" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <RadioButton Content="单次散点 (Binary)"
                   GroupName="ViewMode"
                   IsChecked="{Binding ViewModel.IsHistoricalView, Mode=TwoWay, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"/>
      <RadioButton Content="历史趋势 (Historical)"
                   GroupName="ViewMode"
                   IsEnabled="{Binding ViewModel.CanShowHistoricalView}"
                   IsChecked="{Binding ViewModel.IsHistoricalView, Mode=TwoWay}"
                   VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Row 1: main split — DataGrid | CartesianChart -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0"
                ItemsSource="{Binding ViewModel.Records}"
                SelectedItem="{Binding ViewModel.SelectedRecord, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="MR" Binding="{Binding MrName}" Width="*"/>
          <DataGridTextColumn Header="断言" Binding="{Binding AssertionName}" Width="120"/>
          <DataGridCheckBoxColumn Header="通过" Binding="{Binding Passed}" Width="60"/>
          <DataGridTextColumn Header="源值" Binding="{Binding SourceValue, StringFormat='G4'}" Width="80"/>
          <DataGridTextColumn Header="衍生值" Binding="{Binding FollowUpValue, StringFormat='G4'}" Width="80"/>
          <DataGridTextColumn Header="运行时间"
                              Binding="{Binding RunAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                              Width="140"/>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <Grid>
          <lvc:CartesianChart Series="{Binding ViewModel.ChartBinding.Series, FallbackValue={x:Null}}"
                              XAxes="{Binding ViewModel.ChartBinding.XAxes, FallbackValue={x:Null}}"
                              YAxes="{Binding ViewModel.ChartBinding.YAxes, FallbackValue={x:Null}}"
                              LegendPosition="Top"
                              Visibility="{Binding ViewModel.ChartVisibility}"/>
          <TextBlock Text="（无数据）"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorDisabledBrush}"
                     Visibility="{Binding ViewModel.EmptyOverlayVisibility}"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Row 2: status bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding ViewModel.StatusMessage}"
                   VerticalAlignment="Center"/>
        <ui:ProgressRing Grid.Column="1"
                         IsIndeterminate="True"
                         Width="20" Height="20"
                         Visibility="{Binding ViewModel.BusyVisibility}"/>
      </Grid>
    </Border>
  </Grid>
</Page>
