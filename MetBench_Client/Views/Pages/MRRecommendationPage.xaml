<Page x:Class="MetBench_Client.Views.Pages.MRRecommendationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
      xmlns:s="https://github.com/canton7/Stylet"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:MetBench_Domain;assembly=MetBench_Domain"
      xmlns:models1="clr-namespace:MetBench_Client.Models"
      xmlns:viewmodels="clr-namespace:MetBench_Client.ViewModels"
      xmlns:controls="clr-namespace:MetBench_Client.Controls"
      xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance viewmodels:MRRecommendationViewModel}"
      d:DesignHeight="800"
      d:DesignWidth="1000"
      
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="MRRecommendationPage">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="330" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="270" />
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <StackPanel>

                <ui:DataGrid  LoadingRow="dataGrid_LoadingRow" BorderBrush="LightGray"  BorderThickness="2" MaxHeight="320" Margin="10 0 10 10"  FontSize="15" HeadersVisibility="Column"  SelectedItem="{Binding ViewModel.DataGridSelectItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="datagrid"  ItemsSource="{Binding ViewModel.Data,UpdateSourceTrigger=PropertyChanged}"  AutoGenerateColumns="False" CanUserAddRows="False" AutomationProperties.AutomationId="DataGrid_MR"
                    s:View.ActionTarget="{Binding ViewModel}"
                    MouseDoubleClick="{s:Action show}"
                  >
                    <!--进行datagrid的TextColumn 进行居中-->
                    <DataGrid.Resources>
                        <Style x:Key="CenteredTextBlockStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!--<DataGridTemplateColumn  Width="70"  MinWidth="10" IsReadOnly="True" >
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Number" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}"  HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn >-->

                        <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding TargetProgram.FunctionName}" Width="200" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_Application], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Similarity}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_Similarity], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>



                        <DataGridTemplateColumn IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_InputPattern], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalContentAlignment="Center">
                                        <Image Source="{Binding InputPatternImagepath}" />
                                    </ScrollViewer>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_OutputPattern], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalContentAlignment="Center">
                                        <Image Source="{Binding OutputPatternImagepath}" />
                                    </ScrollViewer>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  Width="150" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_MrInformation], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button  Width="100" Height="50" FontSize="14" Content="{Binding Data.ViewModel.Localization[Recommend_View], Source={StaticResource LocalizationProxy}}" HorizontalAlignment="Center" AutomationProperties.AutomationId="Button_MT"
                                     Appearance="Primary"
                                     Icon="{ui:SymbolIcon CalculatorArrowClockwise24}"
                                     Command="{s:Action btn_EditSelectedMR}"
                                     CommandParameter="{Binding MetamorphicRelation.IdMR}" 
                                     />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn  Width="150" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_ApplicationInformation], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button  Width="100" Height="50" FontSize="14" Content="{Binding Data.ViewModel.Localization[Recommend_View], Source={StaticResource LocalizationProxy}}" HorizontalAlignment="Center" AutomationProperties.AutomationId="Button_MT"
                                                Appearance="Primary"
                                                Icon="{ui:SymbolIcon CalculatorArrowClockwise24}"
                                                Command="{s:Action btn_EditSelectedApplication}"
                                                CommandParameter="{Binding Application.IdApplication}" 
                                                />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Value}" Width="200" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding Data.ViewModel.Localization[Recommend_SupportRate], Source={StaticResource LocalizationProxy}}"></TextBlock>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>

            </StackPanel>

        </Grid>
        <Grid Grid.Row="1">
            <controls:SimplePagination x:Name="pagination" Margin="0 2 5 0" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                MaxPageCount="{Binding ViewModel.MaxPageCount, UpdateSourceTrigger=PropertyChanged}"
                PageIndex="{Binding ViewModel.PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                PageUpdated="pagination_PageUpdated"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0 3 0 5">
                <TextBlock Text="{Binding ViewModel.Localization[Recommend_RecommendType]}" Margin="22 0 0 0" VerticalAlignment="Center" />
                <ComboBox   Margin="10 0 0 0" Width="150"
                            SelectedIndex="{Binding ViewModel.RecommendType_ComboBoxSelectedIndex,UpdateSourceTrigger=PropertyChanged}"
                            SelectedValue="{Binding ViewModel.RecommendType_ComboBoxSelectedValue,UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding ViewModel.RecommendTypeList,UpdateSourceTrigger=PropertyChanged}"
                            />
                <ui:Button Appearance="Primary" Content="{Binding ViewModel.Localization[Recommend_Recommend]}" Margin="5 0 0 0"
                           s:View.ActionTarget="{Binding ViewModel}"
                           Command="{s:Action btnRecommend_Click}"
                           Icon="{ui:SymbolIcon ZoomIn24}"
                           />
            </StackPanel>
            <StackPanel  Grid.Row="1" Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0 3 0 5">
                <TextBlock Text="{Binding ViewModel.Localization[Recommend_Application]}" Margin="80 0 0 0" VerticalAlignment="Center" />
                <TextBox Text="{Binding ViewModel.CodeName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" s:View.ActionTarget="{Binding ViewModel}" Margin="10 0 0 0" Width="150" />
                <ui:Button Appearance="Info" Content="{Binding ViewModel.Localization[Recommend_Clear]}"
                           Margin="5 0 0 0 "
                           s:View.ActionTarget="{Binding ViewModel}"
                           Command="{s:Action btnBack_Click}" 
                  />
                <ui:Button Appearance="Primary" Content="{Binding ViewModel.Localization[Recommend_Upload]}"
                           Margin="5 0 0 0"
                           s:View.ActionTarget="{Binding ViewModel}"
                           Command="{s:Action btnAddCode_Click}"
                           Icon="{ui:SymbolIcon ArrowUpload24}"
                  />
               
            </StackPanel>
            <StackPanel  Grid.Row="2" x:Name="stackpanel2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.Localization[Recommend_InputParamCount]}"  Margin="18 0 0 0" VerticalAlignment="Center" />
                <ui:TextBox x:Name="txbInputParamCount"  Margin="10 0 0 0" VerticalContentAlignment="Center" Width="170"
             InputMethod.IsInputMethodEnabled="False"
             Language="en-US"
             TextWrapping="Wrap"
             Text="{Binding ViewModel.InputParamCount,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
             />
                <ui:Button Appearance="Primary"  Content="{Binding ViewModel.Localization[Recommend_Reset]}" Margin="3 0 0 0"
                Icon="{ui:SymbolIcon TextBulletListSquareSettings20}"
                s:View.ActionTarget="{Binding ViewModel}"
                Command="{s:Action btn_Cancle}"
               />
            </StackPanel>
            <StackPanel  Grid.Row="3" x:Name="stackpanel3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.Localization[Recommend_InputParamRanges]}"  Margin="10 0 0 0" VerticalAlignment="Center" />
                <ui:TextBox x:Name="txbMaxNumber"  Margin="10 0 0 0" VerticalContentAlignment="Center" Width="170"
              InputMethod.IsInputMethodEnabled="False"
              Language="en-US"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.InputParamRanges,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              />
            </StackPanel>
            <StackPanel  Grid.Row="4" x:Name="stackpanel4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.Localization[Recommend_InputDatatypes]}"  Margin="33 0 0 0" VerticalAlignment="Center" />
                <ui:TextBox x:Name="txbExecuteNumb" Margin="10 0 0 0" VerticalContentAlignment="Center" Width="170"
              InputMethod.IsInputMethodEnabled="False"
              Language="en-US"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.InputDatatypes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" >
                <ProgressBar IsIndeterminate="{Binding ViewModel.IsIndeterminate,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Visibility="{Binding ViewModel.Visibility, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"    Height="20"  BorderThickness="2" Margin="0,10,0,10" />
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>
