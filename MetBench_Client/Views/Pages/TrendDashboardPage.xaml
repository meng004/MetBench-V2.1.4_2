<Page x:Class="MetBench_Client.Views.Pages.TrendDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="TrendDashboardPage"
      d:DesignHeight="750" d:DesignWidth="1100"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: DatePicker + compute button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Week start (UTC):" VerticalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding ViewModel.WeekStart, Mode=TwoWay}"
                        Width="160" Margin="0,0,12,0" />
            <ui:Button Appearance="Primary"
                       Content="Compute"
                       Icon="{ui:SymbolIcon DataTrending20}"
                       Command="{Binding ViewModel.ComputeCommand}" />
            <ProgressBar IsIndeterminate="True" Width="80" Height="8"
                         VerticalAlignment="Center" Margin="12,0,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>

        <!-- Row 1: KPI cards -->
        <Border Grid.Row="1" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.Report}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <!-- Executions KPI -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="12,8" Margin="0,0,8,0" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="Executions" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Report.Executions}"
                                   FontSize="24" FontWeight="Bold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="WoW: " />
                            <Run Text="{Binding ViewModel.Report.ExecutionsDelta, Mode=OneWay, StringFormat={}{0:+0.0;-0.0;0.0}%}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Anomalies KPI -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="12,8" Margin="0,0,8,0" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="Anomalies" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Report.Anomalies}"
                                   FontSize="24" FontWeight="Bold" Foreground="#E67E22" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="vs prev: " />
                            <Run Text="{Binding ViewModel.Report.AnomaliesWoW}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Anomaly Rate KPI -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="12,8" Margin="0,0,8,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="Anomaly Rate" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Report.AnomalyRate, StringFormat=P1}"
                                   FontSize="24" FontWeight="Bold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="WoW Δ: " />
                            <Run Text="{Binding ViewModel.Report.AnomalyRatePoints, Mode=OneWay, StringFormat={}{0:+0.0%;-0.0%;0.0%}}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Bursts KPI -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="12,8" Margin="0,0,8,0" MinWidth="100">
                    <StackPanel>
                        <TextBlock Text="Bursts" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Report.Bursts.Count}"
                                   FontSize="24" FontWeight="Bold" Foreground="#E74C3C" />
                        <TextBlock Text="detected" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <!-- Promoted MRs KPI -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="12,8" Margin="0,0,0,0" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="Promoted MRs" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ViewModel.Report.PromotedMRs}"
                                   FontSize="24" FontWeight="Bold" Foreground="#27AE60" />
                        <TextBlock Text="this week" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Row 2: Headline text -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.Report}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ViewModel.Report.Headline}"
                       TextWrapping="Wrap" FontStyle="Italic" />
        </Border>

        <!-- Row 3: Line chart + Bursts DataGrid side by side -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Line chart: 5-week trend -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="5-Week Trend (Executions / Anomalies)"
                               FontWeight="Bold" Margin="0,0,0,6" />
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding ViewModel.ChartSeries}"
                                        LegendPosition="Top"
                                        MinHeight="160" />
                </Grid>
            </Border>

            <!-- Bursts DataGrid -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Anomaly Bursts" FontWeight="Bold" Margin="0,0,0,6" />
                    <ui:DataGrid Grid.Row="1"
                                 ItemsSource="{Binding ViewModel.Bursts}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 CanUserAddRows="False">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="50" />
                            <DataGridTextColumn Header="σ" Binding="{Binding SigmasAbove, StringFormat=F1}" Width="50" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: Error message -->
        <TextBlock Grid.Row="4" Text="{Binding ViewModel.ErrorMessage}"
                   Foreground="OrangeRed" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</Page>
