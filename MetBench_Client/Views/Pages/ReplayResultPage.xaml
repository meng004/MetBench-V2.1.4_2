<Page x:Class="MetBench_Client.Views.Pages.ReplayResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pipeline="clr-namespace:MetBench_BLL.SystemMT.Pipeline;assembly=MetBench_BLL.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="ReplayResultPage"
      d:DesignHeight="800" d:DesignWidth="1100"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <ObjectDataProvider x:Key="ClassificationValues" MethodName="GetValues" ObjectType="{x:Type pipeline:ReplayClassification}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="pipeline:ReplayClassification" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Classification → background brush (6 colors). DataTrigger uses Tag bound to ViewModel.Classification. -->
        <Style x:Key="ClassificationBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#777" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="Reproduced">
                    <Setter Property="Background" Value="#C0392B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="FixedOrFlaky">
                    <Setter Property="Background" Value="#F1C40F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="RegressionOnReplay">
                    <Setter Property="Background" Value="#8E0F0F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="StillPassing">
                    <Setter Property="Background" Value="#27AE60" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="MismatchedFailure">
                    <Setter Property="Background" Value="#E67E22" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Classification}" Value="NotComparable">
                    <Setter Property="Background" Value="#7F8C8D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.HasReplayResult}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Anomaly header -->
        <Border Grid.Row="0" Padding="12" Margin="0,0,0,8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ViewModel.Localization[Replay_Title]}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Id: " />
                    <TextBlock Text="{Binding ViewModel.Anomaly.IdAnomaly}" Margin="0,0,16,0" />
                    <TextBlock Text="Severity: " />
                    <TextBlock Text="{Binding ViewModel.Anomaly.Severity}" Margin="0,0,16,0" />
                    <TextBlock Text="Status: " />
                    <TextBlock Text="{Binding ViewModel.Anomaly.Status}" Margin="0,0,16,0" />
                    <TextBlock Text="Discovered: " />
                    <TextBlock Text="{Binding ViewModel.Anomaly.DiscoveredAt, StringFormat=yyyy-MM-dd HH:mm}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 1: Classification badge -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Classification:" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontWeight="SemiBold" />
            <Border Style="{StaticResource ClassificationBadgeStyle}">
                <TextBlock Text="{Binding ViewModel.Classification, FallbackValue=—}"
                           Foreground="White" FontWeight="Bold" FontSize="14" />
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding ViewModel.StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 2: comparison grid -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header row -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="10,8">
                    <TextBlock FontWeight="Bold" Text="Field" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="10,8">
                    <TextBlock FontWeight="Bold" Text="Original" />
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="10,8">
                    <TextBlock FontWeight="Bold" Text="Replay" />
                </Border>

                <!-- MR -->
                <TextBlock Grid.Row="1" Grid.Column="0" Padding="10,6" Text="MR" />
                <TextBlock Grid.Row="1" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.MrCode}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.MrCode}" />

                <!-- SUT -->
                <TextBlock Grid.Row="2" Grid.Column="0" Padding="10,6" Text="SUT" />
                <TextBlock Grid.Row="2" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.SutName}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.SutName}" />

                <!-- Trigger parameters -->
                <TextBlock Grid.Row="3" Grid.Column="0" Padding="10,6" Text="Trigger parameters" />
                <TextBlock Grid.Row="3" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.TriggerParameters}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.TriggerParameters}" TextWrapping="Wrap" />

                <!-- Source value -->
                <TextBlock Grid.Row="4" Grid.Column="0" Padding="10,6" Text="Source value" />
                <TextBlock Grid.Row="4" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.OriginalSourceValue, StringFormat=F6, FallbackValue=—}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.ReplaySourceValue, StringFormat=F6, FallbackValue=—}" />

                <!-- Followup value -->
                <TextBlock Grid.Row="5" Grid.Column="0" Padding="10,6" Text="Followup value" />
                <TextBlock Grid.Row="5" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.OriginalFollowupValue, StringFormat=F6, FallbackValue=—}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.ReplayFollowupValue, StringFormat=F6, FallbackValue=—}" />

                <!-- Assertion expression -->
                <TextBlock Grid.Row="6" Grid.Column="0" Padding="10,6" Text="Assertion" />
                <TextBlock Grid.Row="6" Grid.Column="1" Padding="10,6" Text="{Binding ViewModel.OriginalAssertionExpression}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="6" Grid.Column="2" Padding="10,6" Text="{Binding ViewModel.ReplayAssertionExpression}" TextWrapping="Wrap" />

                <!-- Final status -->
                <TextBlock Grid.Row="7" Grid.Column="0" Padding="10,6" Text="Final status" />
                <TextBlock Grid.Row="7" Grid.Column="1" Padding="10,6" FontWeight="SemiBold" Text="{Binding ViewModel.OriginalFinalStatus}" />
                <TextBlock Grid.Row="7" Grid.Column="2" Padding="10,6" FontWeight="SemiBold" Text="{Binding ViewModel.ReplayFinalStatus}" />
            </Grid>
        </Border>

        <!-- Row 3: replay controls — real path + simulate fallback -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary"
                       Content="Run real replay"
                       Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding ViewModel.RunRealReplayCommand}"
                       Margin="0,0,16,0" />
            <TextBlock Text="Simulate classification:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Source={StaticResource ClassificationValues}}"
                      SelectedValue="{Binding ViewModel.DemoClassification, Mode=TwoWay}"
                      Width="220" Margin="0,0,8,0" />
            <ui:Button Appearance="Secondary"
                       Content="Simulate replay"
                       Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                       Command="{Binding ViewModel.SimulateReplayCommand}" />
            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         Margin="12,0,0,0" VerticalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>

        <!-- Row 4: error/status footer -->
        <TextBlock Grid.Row="4" Margin="0,12,0,0"
                   Foreground="OrangeRed"
                   Text="{Binding ViewModel.ErrorMessage}" TextWrapping="Wrap" />
    </Grid>
</Page>
