<Page
    x:Class="MetBench_Client.Views.Pages.SystemMtSampleCaseCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SystemMtSampleCaseCatalogPage"
    d:DataContext="{d:DesignInstance local:SystemMtSampleCaseCatalogPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    AutomationProperties.AutomationId="SystemMtSampleCaseCatalogPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="22" FontWeight="Medium" Text="System MT Sample Case Catalog"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Browse and edit sample JSON files under SUT/&lt;sut&gt;/sample/. Files referenced by an MR binding cannot be deleted."/>
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="SUT"/>
                    <ComboBox
                        x:Name="ComboBox_SampleCaseSut"
                        Margin="0,4,0,0"
                        AutomationProperties.AutomationId="ComboBox_SampleCaseSut"
                        DisplayMemberPath="SutId"
                        ItemsSource="{Binding ViewModel.Suts, Mode=OneWay}"
                        SelectedItem="{Binding ViewModel.SelectedSut, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,22,0,0" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}"
                        Content="Reload"/>
                    <ui:Button
                        x:Name="Button_NewSampleDraft"
                        AutomationProperties.AutomationId="Button_NewSampleDraft"
                        Command="{Binding ViewModel.NewSampleDraftCommand, Mode=OneWay}"
                        Content="New sample"/>
                </StackPanel>

                <TextBlock
                    x:Name="TextBlock_SystemMtSampleCaseStatus"
                    Grid.Column="2"
                    Margin="16,22,0,0"
                    AutomationProperties.AutomationId="TextBlock_SystemMtSampleCaseStatus"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ui:DataGrid
                    x:Name="DataGrid_SystemMtSampleCases"
                    AutomationProperties.AutomationId="DataGrid_SystemMtSampleCases"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.Samples, Mode=OneWay}"
                    SelectedItem="{Binding ViewModel.SelectedSample, Mode=TwoWay}">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding FileName}" Header="File name"/>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="File name"/>
                    <ui:TextBox
                        x:Name="TextBox_SampleFileName"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="TextBox_SampleFileName"
                        Text="{Binding ViewModel.DraftFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBox
                        x:Name="TextBox_SampleJsonBody"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        AutomationProperties.AutomationId="TextBox_SampleJsonBody"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        HorizontalScrollBarVisibility="Auto"
                        Padding="8"
                        Text="{Binding ViewModel.DraftJsonBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"/>
                </Border>

                <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0" Orientation="Horizontal">
                    <ui:Button
                        x:Name="Button_ValidateSample"
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="Button_ValidateSample"
                        Command="{Binding ViewModel.ValidateSampleCommand, Mode=OneWay}"
                        Content="Validate"/>
                    <ui:Button
                        x:Name="Button_SaveSample"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        AutomationProperties.AutomationId="Button_SaveSample"
                        Command="{Binding ViewModel.SaveSampleCommand, Mode=OneWay}"
                        Content="Save"/>
                    <ui:Button
                        x:Name="Button_DeleteSample"
                        Appearance="Danger"
                        AutomationProperties.AutomationId="Button_DeleteSample"
                        Command="{Binding ViewModel.DeleteSampleCommand, Mode=OneWay}"
                        Content="Delete"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
