<Page x:Class="MetBench_Client.Views.Pages.CandidateReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
      Title="CandidateReviewPage"
      d:DesignHeight="750" d:DesignWidth="1100"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}" />
    </Page.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: candidate picker + info card -->
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Candidate picker -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ViewModel.Localization[Candidate_SelectCandidate]}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding ViewModel.Candidates}"
                              SelectedItem="{Binding ViewModel.SelectedCandidate, Mode=TwoWay}"
                              DisplayMemberPath="ProposedCode"
                              Width="260" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ViewModel.SelectedCandidate.Status, FallbackValue=''}" />
                </StackPanel>

                <!-- Candidate info row 1 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding ViewModel.Localization[Legacy_Name]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ViewModel.SelectedCandidate.ProposedName, FallbackValue=—}"
                               Margin="0,0,24,0" TextWrapping="Wrap" MaxWidth="500" />
                    <TextBlock Text="{Binding ViewModel.Localization[Candidate_Confidence]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ViewModel.SelectedCandidate.Confidence, StringFormat=F2, FallbackValue=—}"
                               Margin="0,0,24,0" />
                    <TextBlock Text="{Binding ViewModel.Localization[Candidate_Assertion]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ViewModel.SelectedCandidate.SuggestedAssertionTypeCode, FallbackValue=—}" />
                </StackPanel>

                <!-- Rationale -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding ViewModel.Localization[Candidate_Rationale]}" FontWeight="SemiBold" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ViewModel.SelectedCandidate.Rationale, FallbackValue=—}"
                               TextWrapping="Wrap" MaxWidth="800"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: validators + validate button + status -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ViewModel.Localization[Candidate_Validators]}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{Binding ViewModel.Localization[Candidate_Empirical]}"
                              IsChecked="{Binding ViewModel.UseEmpirical, Mode=TwoWay}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="{Binding ViewModel.Localization[Candidate_TheoreticalLlm]}"
                              IsChecked="{Binding ViewModel.UseTheoreticalLlm, Mode=TwoWay}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />
                    <ui:Button Appearance="Primary"
                               Content="{Binding ViewModel.Localization[Candidate_ValidateSelected]}"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Command="{Binding ViewModel.ValidateSelectedCommand}" />

                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                 Margin="12,0,0,0" VerticalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ViewModel.StatusMessage}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ViewModel.ErrorMessage}"
                               Foreground="OrangeRed"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 2: validation history DataGrid -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding ViewModel.ValidationHistory}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     HeadersVisibility="Column"
                     CanUserAddRows="False"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Candidate_ColValidator], Source={StaticResource LocalizationProxy}}"   Binding="{Binding ValidatorName}"              Width="160" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Candidate_ColPassed], Source={StaticResource LocalizationProxy}}"      Binding="{Binding Passed}"                     Width="70" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Candidate_ColRunAt], Source={StaticResource LocalizationProxy}}"      Binding="{Binding RunAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                <DataGridTextColumn Header="{Binding Data.ViewModel.Localization[Candidate_ColDetails], Source={StaticResource LocalizationProxy}}"     Binding="{Binding DetailsJson}"                Width="*" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
