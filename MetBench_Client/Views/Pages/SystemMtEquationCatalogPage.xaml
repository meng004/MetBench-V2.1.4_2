<Page
    x:Class="MetBench_Client.Views.Pages.SystemMtEquationCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:MetBench_Client.Helpers"
    xmlns:local="clr-namespace:MetBench_Client.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SystemMtEquationCatalogPage"
    d:DataContext="{d:DesignInstance local:SystemMtEquationCatalogPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    AutomationProperties.AutomationId="SystemMtEquationCatalogPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BindingProxy x:Key="LocalizationProxy" Data="{Binding}"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="22" FontWeight="Medium" Text="{Binding ViewModel.Localization[Catalog_EquationCatalogTitle]}"/>
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.Localization[Catalog_EquationCatalogSubtitle]}"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="14"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ViewModel.RefreshEquationsCommand, Mode=OneWay}"
                    Content="{Binding ViewModel.Localization[Catalog_Reload]}"/>
                <Button
                    x:Name="Button_NewEquationDraft"
                    Margin="0,0,16,0"
                    AutomationProperties.AutomationId="Button_NewEquationDraft"
                    Command="{Binding ViewModel.NewEquationDraftCommand, Mode=OneWay}"
                    Content="{Binding ViewModel.Localization[Catalog_NewEquation]}"/>
                <TextBlock
                    x:Name="TextBlock_SystemMtEquationCatalogStatus"
                    Margin="0,4,0,0"
                    AutomationProperties.AutomationId="TextBlock_SystemMtEquationCatalogStatus"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <DataGrid
                    x:Name="DataGrid_SystemMtEquations"
                    AutomationProperties.AutomationId="DataGrid_SystemMtEquations"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.Equations, Mode=OneWay}"
                    SelectedItem="{Binding ViewModel.SelectedEquation, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="140" Binding="{Binding EquationKey}" Header="{Binding Data.ViewModel.Localization[Catalog_Key], Source={StaticResource LocalizationProxy}}"/>
                        <DataGridTextColumn Width="200" Binding="{Binding Name}" Header="{Binding Data.ViewModel.Localization[Legacy_Name], Source={StaticResource LocalizationProxy}}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding CanonicalForm}" Header="{Binding Data.ViewModel.Localization[Catalog_CanonicalForm], Source={StaticResource LocalizationProxy}}"/>
                        <DataGridTextColumn Width="80" Binding="{Binding Source}" Header="{Binding Data.ViewModel.Localization[Catalog_Source], Source={StaticResource LocalizationProxy}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border
                    Padding="14"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Catalog_EquationKey]}"/>
                        <TextBox
                            x:Name="TextBox_EquationKey"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_EquationKey"
                            IsReadOnly="{Binding ViewModel.IsDraftReadOnly, Mode=OneWay}"
                            Text="{Binding ViewModel.Draft.EquationKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="{Binding ViewModel.Localization[Legacy_Name]}"/>
                        <TextBox
                            x:Name="TextBox_EquationName"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="TextBox_EquationName"
                            IsReadOnly="{Binding ViewModel.IsDraftReadOnly, Mode=OneWay}"
                            Text="{Binding ViewModel.Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="{Binding ViewModel.Localization[Catalog_CanonicalForm]}"/>
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="{Binding ViewModel.IsDraftReadOnly, Mode=OneWay}"
                            MinHeight="60"
                            Text="{Binding ViewModel.Draft.CanonicalForm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="{Binding ViewModel.Localization[Catalog_SymbolSystem]}"/>
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AcceptsReturn="True"
                            IsReadOnly="{Binding ViewModel.IsDraftReadOnly, Mode=OneWay}"
                            MinHeight="60"
                            Text="{Binding ViewModel.Draft.SymbolSystem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                x:Name="Button_ValidateEquationDraft"
                                Margin="0,12,8,0"
                                AutomationProperties.AutomationId="Button_ValidateEquationDraft"
                                Command="{Binding ViewModel.ValidateEquationDraftCommand, Mode=OneWay}"
                                Content="{Binding ViewModel.Localization[Catalog_Validate]}"/>
                            <Button
                                x:Name="Button_SaveEquationDraft"
                                Margin="0,12,8,0"
                                AutomationProperties.AutomationId="Button_SaveEquationDraft"
                                Command="{Binding ViewModel.SaveEquationDraftCommand, Mode=OneWay}"
                                Content="{Binding ViewModel.Localization[Legacy_Save]}"/>
                            <Button
                                x:Name="Button_DeleteEquation"
                                Margin="0,12,0,0"
                                AutomationProperties.AutomationId="Button_DeleteEquation"
                                Command="{Binding ViewModel.DeleteEquationCommand, Mode=OneWay}"
                                Content="{Binding ViewModel.Localization[Legacy_Delete]}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="Border_EquationExplanationCard"
                    Margin="0,12,0,0"
                    Padding="14"
                    AutomationProperties.AutomationId="Border_EquationExplanationCard"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" FontWeight="Medium" Text="{Binding ViewModel.Localization[SystemMt_Equation_ExplanationHeader]}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_Class]}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.EquationClassDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_Family]}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.EquationFamilyDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_PrimaryVariables]}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.PrimaryVariablesDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_PhysicalMeaning]}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.PhysicalMeaningDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_BenchmarkRationale]}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ViewModel.BenchmarkRationaleDisplay, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Localization[SystemMt_Equation_ExpectedLaws]}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ViewModel.ExpectedLawsDisplay, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
