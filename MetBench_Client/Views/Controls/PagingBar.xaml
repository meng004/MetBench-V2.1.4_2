<UserControl x:Class="MetBench_Client.Views.Controls.PagingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="600">
    <!--
        通用分页条 — 绑定继承的 DataContext = PagingViewModel<T>。

        用法（调用页）：
            <Page xmlns:controls="clr-namespace:MetBench_Client.Views.Controls">
                ...
                <controls:PagingBar DataContext="{Binding ViewModel}" />

        命令 / 属性来自 MetBench_BLL.Paging.PagingViewModel<T> 基类：
            FirstPageCommand / PreviousPageCommand / NextPageCommand /
            LastPageCommand / RefreshCommand
            PageIndex / TotalPages / TotalCount / PageSize / IsLoading

        如果调用方 ViewModel 自身不是 PagingViewModel<T>，可显式给 DataContext。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel x:Name="Root" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
        <!-- First / Previous -->
        <ui:Button Appearance="Secondary" Margin="0,0,4,0"
                   ToolTip="{Binding Localization[PagingBar_FirstPage]}"
                   Command="{Binding FirstPageCommand}"
                   Icon="{ui:SymbolIcon ChevronDoubleLeft20}" />
        <ui:Button Appearance="Secondary" Margin="0,0,8,0"
                   ToolTip="{Binding Localization[PagingBar_PreviousPage]}"
                   Command="{Binding PreviousPageCommand}"
                   Icon="{ui:SymbolIcon ChevronLeft20}" />

        <!-- Page x / y (total z) -->
        <TextBlock VerticalAlignment="Center" Margin="0,0,4,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Run Text="{Binding Localization[PagingBar_Page], Mode=OneWay}" />
            <Run Text="{Binding PageIndex, Mode=OneWay}" />
            <Run Text="/" />
            <Run Text="{Binding TotalPages, Mode=OneWay}" />
            <Run Text="  (" />
            <Run Text="{Binding TotalCount, Mode=OneWay}" />
            <Run Text="{Binding Localization[PagingBar_TotalSuffix], Mode=OneWay}" />
        </TextBlock>

        <!-- Next / Last -->
        <ui:Button Appearance="Secondary" Margin="8,0,4,0"
                   ToolTip="{Binding Localization[PagingBar_NextPage]}"
                   Command="{Binding NextPageCommand}"
                   Icon="{ui:SymbolIcon ChevronRight20}" />
        <ui:Button Appearance="Secondary" Margin="0,0,12,0"
                   ToolTip="{Binding Localization[PagingBar_LastPage]}"
                   Command="{Binding LastPageCommand}"
                   Icon="{ui:SymbolIcon ChevronDoubleRight20}" />

        <!-- Page size -->
        <TextBlock Text="{Binding Localization[PagingBar_PageSize]}" VerticalAlignment="Center" Margin="0,0,4,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox SelectedValue="{Binding PageSize}"
                  SelectedValuePath="Content"
                  Width="64">
            <ComboBoxItem><sys:Int32>10</sys:Int32></ComboBoxItem>
            <ComboBoxItem><sys:Int32>25</sys:Int32></ComboBoxItem>
            <ComboBoxItem><sys:Int32>50</sys:Int32></ComboBoxItem>
            <ComboBoxItem><sys:Int32>100</sys:Int32></ComboBoxItem>
        </ComboBox>

        <!-- Refresh + busy indicator -->
        <ui:Button Appearance="Primary" Margin="12,0,0,0"
                   ToolTip="{Binding Localization[PagingBar_RefreshTooltip]}"
                   Command="{Binding RefreshCommand}"
                   Content="{Binding Localization[PagingBar_Refresh]}" />
        <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
