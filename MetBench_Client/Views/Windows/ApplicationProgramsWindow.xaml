<ui:FluentWindow x:Class="MetBench_Client.Views.Windows.ApplicationProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetBench_Client.Views.Windows"
        xmlns:viewmodels="clr-namespace:MetBench_Client.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        d:DataContext="{d:DesignInstance viewmodels:ApplicationManagementViewModel}"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Edit Params Window" ShowClose="False" ShowMinimize="False" ShowMaximize="False"/>
        <ui:DataGrid Grid.Row="1" x:Name="ParametersGrid" MaxHeight="250" CanUserAddRows="True"
                  ItemsSource="{Binding ViewModel.Params,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="True">
            <!--进行datagrid的TextColumn 进行居中-->
            <DataGrid.Resources>
                <Style x:Key="CenteredTextBlockStyle" TargetType="{x:Type TextBlock}">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Width="100" >
                    <DataGridTextColumn.Header>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Name"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Type,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Type"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Description,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Width="150">
                    <DataGridTextColumn.Header>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Description"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding Constraints,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Width="100" >
                    <DataGridTextColumn.Header>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="Constraints"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredTextBlockStyle}"  Binding="{Binding IsRequired,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Width="100" >
                    <DataGridTextColumn.Header>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"  Text="IsRequired"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- 按钮区 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2">
            <ui:Button Appearance="Primary" Content="OK" Width="100"
            Command="{Binding ViewModel.WindowOkCommand}"
            />

            <ui:Button Appearance="Primary" Content="Cancel" Width="100"
                       Margin="10 0 0 0"
                       Command="{Binding ViewModel.WindowCancelCommand}"
             />
        </StackPanel>
    </Grid>

</ui:FluentWindow>
