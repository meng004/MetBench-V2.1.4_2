<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D7DEE8"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C2410C"/>

    <Style x:Key="StackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
