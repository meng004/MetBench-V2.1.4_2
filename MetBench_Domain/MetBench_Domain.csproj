<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!--
      Maturity remediation Phase 3: Domain is now 0-warning under nullable;
      this ratchet locks the gain so future fields can't reintroduce silent
      NPE risk on LiteDB deserialize paths. See
      docs/superpowers/plans/2026-06-06-metbench-maturity-remediation-plan.md §3.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
