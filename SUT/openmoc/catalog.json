      ],
      "tolerance_rel": 0,
      "tolerance_abs": 0,
      "noise_aware": false,
      "equation_key": "",
      "equation": "Boltzmann",
      "program_type": "Num",
      "meta_pattern": "Conv",
      "source_level": "Manual",
      "failure_correlation": "None",
