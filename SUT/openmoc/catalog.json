      "work_root_name": "MetBenchOpenMocRayTracks",
      "timeout_seconds": 300,
      "refinement_phases": [
        { "role": "coarse",    "parameters": { "factor": "1" } },
        { "role": "medium",    "parameters": { "factor": "2" } },
        { "role": "reference", "parameters": { "factor": "4" } }
      ]
    }
