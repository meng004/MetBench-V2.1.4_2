      ],
      "tolerance_rel": 0,
      "tolerance_abs": 0,
      "noise_aware": false,
      "equation_key": "poisson",
      "equation": "Poisson",
      "program_type": "Num",
      "meta_pattern": "Mono",
      "source_level": "Manual",
      "failure_correlation": "None",
      "sample_case_relative_path": "sample/standard.json",
      "work_root_name": "MetBenchScipyBvpPoisson1d",
