      "sut_name": "diffusion-1d",
      "display_name": "1D diffusion — MeshRichardson (FD convergence)",
      "description": "Mesh-refinement Richardson convergence MP_conv: doubling num_points (halving the FD spacing dx) must leave φ_max within FD truncation tolerance — the second-order scheme is already at the fine-mesh plateau.",
      "mr_family": "Diffusion.Convergence.Mesh",
      "transformation_name": "ScaleField",
      "assertion_type_code": "approx",
