      "transform_steps": [
        { "transformation_name": "ScaleField", "target_field_path": "/params/num_steps" }
      ],
      "tolerance_rel": 1e-3,
      "tolerance_abs": 1e-6,
      "noise_aware": false,
      "equation_key": "bateman",
      "equation": "Bateman",
      "program_type": "Num",
      "meta_pattern": "Conv",
      "source_level": "Manual",
      "failure_correlation": "None",
