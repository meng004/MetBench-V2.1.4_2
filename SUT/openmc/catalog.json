      ],
      "tolerance_rel": 0,
      "tolerance_abs": 0,
      "noise_aware": false,
      "equation_key": "",
      "equation": "Boltzmann",
      "program_type": "MC",
      "meta_pattern": "Mono",
      "source_level": "Manual",
      "failure_correlation": "None",
      "sample_case_relative_path": "sample/pincell.json",
      "work_root_name": "MetBenchOpenMcNuSigmaF",
      "timeout_seconds": 300
