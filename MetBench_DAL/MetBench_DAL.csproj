<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MetBench_DAL</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!--
      Maturity remediation Phase 3 step 2: DAL is now 0-warning under nullable
      (CS8618/8625/8766 fixed; intentional CS0618 v1 read-compat isolated via
      file-level #pragma). This ratchet locks the gain. See
      docs/superpowers/plans/2026-06-06-metbench-maturity-remediation-plan.md §3.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetBench_BLL.Core\MetBench_BLL.Core.csproj" />
    <ProjectReference Include="..\MetBench_Domain\MetBench_Domain.csproj" />
    <ProjectReference Include="..\MetBench_IDAL\MetBench_IDAL.csproj" />
  </ItemGroup>

</Project>
