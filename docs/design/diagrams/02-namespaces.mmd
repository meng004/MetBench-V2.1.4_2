        Modules["Discovery/ Mutation/ Coverage/<br/>Trend/ Reports/ ...<br/>(P6-P8)"]
    end

    subgraph DAL["MetBench_DAL (LiteDB 实现)"]
        DbConfig["DbConfig 单例<br/>23 collection 注册"]
